API_INTERNAL_URL=http://localhost:5005
NEXT_PUBLIC_API_URL=http://localhost:5005
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8080/realms/buildingflow
NEXT_PUBLIC_OIDC_CLIENT_ID=buildingflow-web

# Private server/build flag; rebuild after changing.
BUILDINGFLOW_PERSON_CENTER_ENABLED=false

# Opt-in central login/workspace flow. Rebuild the web application after changing.
BUILDINGFLOW_SESSION_CONTEXTS_ENABLED=false

# Public website frontend origin, used only for the published-site link.
NEXT_PUBLIC_WEBSITE_ORIGIN=http://localhost:3004
