# Copy using scripts/init-local.sh, which generates unique local secrets.
POSTGRES_USER=buildingflow
POSTGRES_DB=projects
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
RABBITMQ_USER=buildingflow
RABBITMQ_PASSWORD=
OBJECT_STORAGE_ACCESS_KEY=buildingflow
OBJECT_STORAGE_SECRET_KEY=
GRAFANA_ADMIN_USER=buildingflow-admin
GRAFANA_ADMIN_PASSWORD=
WEB_PORT=3003
API_PORT=5005
POSTGRES_PORT=5436
KEYCLOAK_PORT=8080
# 6379 and 3001 are used by other projects on this machine.
REDIS_PORT=6389
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
OBJECT_STORAGE_PORT=9040
GRAFANA_PORT=3002

MAILPIT_PORT=8025

# Phase10 local observability (no public binding)
OTLP_PORT=14318
PROMETHEUS_PORT=19090
LOKI_PORT=13100

# Only enable on a TLS-terminated deployment with HTTPS public API/OIDC origins.
BUILDINGFLOW_PUBLIC_HTTPS=false

POSTGRES_HOST=postgres-18.6

POSTGRES_LOCAL_HOST=localhost

POSTGRES_SCHEMA=buildingflow

KEYCLOAK_DB_USER=keycloak_shared

KEYCLOAK_DB_SCHEMA=keycloak

SHARED_POSTGRES_NETWORK=shared-postgres-net

KEYCLOAK_INTERNAL_HOST=keycloak-26.7.5
PERSON_CODE_HMAC_KEY=
# Website (optional; empty keeps the feature closed). Keys: base64 of 32+ random bytes, e.g. `openssl rand -base64 32`.
# Draft preview links and the public inquiry form stay disabled until their key is set.
WEBSITE_PREVIEW_HMAC_KEY=
WEBSITE_INQUIRY_HMAC_KEY=
# Platform subdomain suffix for PLATFORM_SUBDOMAIN domains (for example sites.example.com); empty allows CUSTOM domains only.
WEBSITE_PLATFORM_DOMAIN=
BUILDINGFLOW_KEYCLOAK_ADMIN_CLIENT_SECRET=

# Central Person backend remains off until tenant provisioning and phase04 migration are approved.
PersonRefactor__Enabled=false

# Administrative shadow transition; never enable before an explicit tenant/property dry-run.
PersonRefactor__TransitionEnabled=false

# PERSON FAZ05: explicit tenant-scoped ManagementModes are LEGACY/SHADOW/ENFORCED; default LEGACY.
PersonRefactor__AssignmentsEnabled=false

# Person center: enable only after the phase acceptance; rebuild the web image.
BUILDINGFLOW_PERSON_CENTER_ENABLED=false
PersonRefactor__UnitRelationWritesEnabled=false

# Opt-in central login/workspace flow. Rebuild the web application after changing.
BUILDINGFLOW_SESSION_CONTEXTS_ENABLED=false
PersonRefactor__SessionContextsEnabled=false

# Native person authorization snapshot (opt-in, no rollout performed).
PersonRefactor__MobileAuthorizationEnabled=false

# PERSON FAZ09: canonical talep/profil senkronizasyonu (diger kisi/oturum bayraklari gerekir).
PersonRefactor__MobileSyncEnabled=false
