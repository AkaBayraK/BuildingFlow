# Production template for scripts/release-preflight.py. Copy outside Git and fill from a secret store.
# Values below are placeholders; real hostnames, IPs and secrets are environment-specific.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=api.example.com
Authentication__Authority=https://auth.example.com/realms/buildingflow
Authentication__Audience=buildingflow-api
Authentication__MetadataAddress=
Cors__Origins__0=https://app.example.com
# Only the TLS-terminating reverse proxy, as individual IPs.
Security__KnownProxies__0=10.0.0.10
Security__RateLimit__Enabled=true
Security__RateLimit__Anonymous=30
Security__RateLimit__Reads=300
Security__RateLimit__Writes=60
ConnectionStrings__Database=Host=db.internal;Database=buildingflow;Username=buildingflow;Password=
RabbitMQ__Password=
ObjectStorage__SecretKey=
Smtp__Enabled=true
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__UseStartTls=true
Smtp__AllowInsecureLocal=false
Smtp__Username=
Smtp__Password=
Smtp__From=no-reply@example.com
# Web image: NEXT_PUBLIC_* are build arguments; BUILDINGFLOW_PUBLIC_HTTPS is read at runtime.
BUILDINGFLOW_PUBLIC_HTTPS=true
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_OIDC_AUTHORITY=https://auth.example.com/realms/buildingflow
NEXT_PUBLIC_OIDC_CLIENT_ID=buildingflow-web

# Private authenticated S3 gateway; supply a trusted HTTPS endpoint in production.
ObjectStorage__Endpoint=https://objects.example.com
ObjectStorage__AccessKey=buildingflow-api
ObjectStorage__Bucket=buildingflow-documents
