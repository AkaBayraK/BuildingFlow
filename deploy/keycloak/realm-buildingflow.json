{
  "realm": "buildingflow",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN"
      },
      {
        "name": "SITE_ADMIN"
      },
      {
        "name": "MANAGER"
      },
      {
        "name": "ACCOUNTANT"
      },
      {
        "name": "RESIDENT"
      },
      {
        "name": "SECURITY"
      }
    ]
  },
  "clients": [
    {
      "clientId": "buildingflow-web",
      "name": "BuildingFlow Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3003/",
        "http://localhost:3003/login"
      ],
      "webOrigins": [
        "http://localhost:3003"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3003/login"
      },
      "protocolMappers": [
        {
          "name": "buildingflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "buildingflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "buildingflow-api",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "buildingflow-admin-api",
      "name": "BuildingFlow user administration",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret"
    }
  ],
  "loginTheme": "buildingflow",
  "resetPasswordAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr",
    "en"
  ],
  "defaultLocale": "tr",
  "actionTokenGeneratedByUserLifespan": 600,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1)",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@buildingflow.local",
    "fromDisplayName": "BuildingFlow",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "users": [
    {
      "username": "service-account-buildingflow-admin-api",
      "enabled": true,
      "serviceAccountClientId": "buildingflow-admin-api",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users"
        ]
      }
    }
  ]
}
