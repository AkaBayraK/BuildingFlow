{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BuildingFlow: Prepare local development",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/dev.sh",
        "prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "BuildingFlow: Infrastructure only",
      "type": "process",
      "command": "bash",
