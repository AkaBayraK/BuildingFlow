{
  "cli": {
    "version": "24.14.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "22.23.3",
      "env": {
        "BUILDINGFLOW_APP_VARIANT": "development"
      }
    },
    "qa": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "BUILDINGFLOW_APP_VARIANT": "development",
        "BUILDINGFLOW_QA_PROFILE": "1"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "22.23.3",
      "autoIncrement": false,
      "env": {
        "BUILDINGFLOW_APP_VARIANT": "production",
        "EXPO_NO_DOTENV": "1"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      }
    }
  }
}
