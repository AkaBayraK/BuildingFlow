# Public values are bundled into the app. Never put secrets or tokens here.
# Physical devices must use the API server LAN address, not localhost.
# Production requires HTTPS. Only public configuration belongs here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_WEB_URL=
EXPO_PUBLIC_AUTH_ISSUER=
EXPO_PUBLIC_AUTH_WEB_ISSUER=
EXPO_PUBLIC_AUTH_CLIENT_ID=buildingflow-mobile

# Optional native isolated SQLite/SecureStore fixture verification (development only).
EXPO_PUBLIC_VERIFY_OFFLINE=0
