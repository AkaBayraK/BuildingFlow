{
  "clientId": "buildingflow-mobile",
  "name": "BuildingFlow Mobile Development",
  "enabled": true,
  "publicClient": true,
  "protocol": "openid-connect",
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "redirectUris": [
    "buildingflow-dev://auth",
    "http://localhost:8081/auth",
    "http://127.0.0.1:8081/auth",
    "http://localhost:8763/auth",
    "http://127.0.0.1:8763/auth"
  ],
  "webOrigins": [
    "http://localhost:8081",
    "http://127.0.0.1:8081",
    "http://localhost:8763",
    "http://127.0.0.1:8763"
  ],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "buildingflow-dev://auth##http://localhost:8081/auth##http://127.0.0.1:8081/auth##http://localhost:8763/auth##http://127.0.0.1:8763/auth",
    "access.token.lifespan": "60"
  },
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "profile",
    "roles",
    "basic"
  ],
  "protocolMappers": [
    {
      "name": "buildingflow-api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.client.audience": "buildingflow-api",
        "id.token.claim": "false",
        "access.token.claim": "true"
      }
    }
  ]
}
