{
  "expo": {
    "name": "BuildingFlow",
    "slug": "buildingflow-mobile",
    "version": "0.1.0",
    "scheme": "buildingflow-dev",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "BuildingFlow çevrimdışı bilgilerini açmak için biyometrik doğrulama kullanır."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İsteğiniz üzerine profil ve talep fotoğrafı seçmek için fotoğraflarınıza erişim kullanılır.",
          "cameraPermission": "İsteğiniz üzerine profil ve talep fotoğrafı çekmek için kamera kullanılır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/app-icon.png",
          "backgroundColor": "#F6F9FC",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buildingflow.mobile.dev",
      "appleTeamId": "458K2B3ZS8"
    },
    "android": {
      "package": "com.buildingflow.mobile.dev",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#F6F9FC"
      },
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "icon": "./assets/brand/app-icon.png"
  }
}
